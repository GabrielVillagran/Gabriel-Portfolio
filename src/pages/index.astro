---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { experience } from '../lib/experience';
import { projects } from '../lib/projects';
import { urlFor, publicationDate } from '../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime()).slice(0, 3);
---
<BaseLayout title="Home" description="Gabriel Villagrán is a software engineer with experience in iOS, backend integrations, and industrial monitoring. Explore his work and writing.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="eyebrow">Gabriel Villagrán / Software Engineer</span>
      <h1 id="hero-title">Software engineer.<br /><em>Always learning.</em></h1>
      <p class="lede">I'm a software engineer with experience building iOS and Android applications, backend systems, and alarm and monitoring solutions for major U.S. transportation hubs, including LaGuardia and SFO airports.</p>
      <p class="lede">I have a passion for continuous learning. In my free time, I'm learning to build video games using Three.js and develop small apps.</p>
      <div class="hero-actions"><a class="button-primary" href={urlFor('work/')}>Explore my experience <span aria-hidden="true">↗</span></a><a class="text-link" href={urlFor('about/')}>More about me <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-art">
      <img src={urlFor('images/gabriel-profile.webp')} alt="Gabriel standing in front of the Golden Gate Bridge" width="964" height="868" fetchpriority="high" />
    </div>
  </section>

  <section class="section" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="eyebrow">01 / Experience</span><h2 id="work-title">Working Experience.</h2><p>Places I’ve had the pleasure of building great things with.</p></div><a class="text-link" href={urlFor('work/')}>All experience <span aria-hidden="true">↗</span></a></div>
    <div class="work-grid">{experience.map((position) => <WorkCard position={position} />)}</div>
  </section>

  <section class="section writing-band" aria-labelledby="writing-title">
    <div class="section-heading"><div><span class="eyebrow">02 / Writing</span><h2 id="writing-title">Welcome to my place.</h2><p>Here you can find notes from my time in the LaunchX bootcamp, along with research and projects I worked on for my university courses.</p></div><a class="text-link" href={urlFor('blog/')}>All articles <span aria-hidden="true">↗</span></a></div>
    <div class="post-list">
      {posts.map((post) => <article class="post-row">
        <time datetime={post.data.published.toISOString()}>{publicationDate(post.data.published)}</time>
        <div><h3><a href={urlFor(`blog/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.description}</p></div>
        <span class="post-meta">{post.data.category} · {post.data.readingMinutes} min</span>
      </article>)}
    </div>
  </section>

  <section class="section projects-section" aria-labelledby="projects-title">
    <div class="section-heading"><div><span class="eyebrow">03 / Personal projects</span><h2 id="projects-title">Personal projects.</h2><p>Small apps, games, and tutorials I've been working on. This is where I share things I build to keep learning. Some projects use LLMs, others don't, and a few are experiments with vibe coding so I can get more practice using AI tools in my workflow.</p></div><a class="text-link" href={urlFor('projects/')}>All projects <span aria-hidden="true">↗</span></a></div>
    {projects.map((project) => <article class="project-teaser">
      <div class="project-teaser-mark" aria-label="Project image coming soon"><span aria-hidden="true">◇</span><small>Image coming soon</small></div>
      <div><span class="status-pill">{project.status}</span><h3>{project.name}</h3><p>{project.description}</p><div class="card-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></div>
      <a class="text-link" href={urlFor('projects/')}>See project <span aria-hidden="true">↗</span></a>
    </article>)}
  </section>

  <section class="section" aria-labelledby="stack-title">
    <div class="section-heading"><div><span class="eyebrow">04 / Tech stack</span><h2 id="stack-title">What I work with.</h2><p>Tools I've used at work, in personal projects, and while learning. I'm not claiming to be an expert in everything here.</p></div></div>
    <div class="stack-groups">
      {[
        { title: 'Mobile', tools: ['Swift', 'SwiftUI', 'UIKit', 'Combine', 'Core Data', 'MapKit', 'iOS', 'Android (learning)'] },
        { title: 'Backend & APIs', tools: ['Java 21', 'Spring Boot (learning)', 'PHP', 'Laravel', 'REST APIs', 'GraphQL', 'RAG', 'AI / LLM integrations'] },
        { title: 'Web & games', tools: ['JavaScript', 'TypeScript', 'React', 'Astro', 'Three.js', 'HTML / CSS', 'Tailwind CSS'] },
        { title: 'Graphics & university work', tools: ['OpenGL', 'C', '3D object viewer (university project)'] },
        { title: 'Data, industrial & tools', tools: ['SQL', 'SQL Server', 'SCADA', 'BACnet', 'OPC', 'Siemens PLCs', 'Docker', 'Git', 'GitHub', 'Postman', 'Firebase', 'Unit testing'] },
      ].map((group) => <div class="stack-group"><h3>{group.title}</h3><div class="card-tags">{group.tools.map((tool) => <span>{tool}</span>)}</div></div>)}
    </div>
  </section>
</BaseLayout>
